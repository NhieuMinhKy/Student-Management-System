@model StudentManagementSystem.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}
@section Styles{
    <link rel="stylesheet" href="~/css/login.css" />
}
<div class="login-wrapper ">
    <form asp-controller="Account" asp-action="Login" method="post">
        <!-- Bắt dữ liệu Role -->
        <div class="role-toggle-container mb-4 fw-bold">
            <input type="radio" asp-for="Role" value="Student" id="roleStudent" class="btn-check" checked />
            <label for="roleStudent" class="role-btn">Student</label>

            <input type="radio" asp-for="Role" value="Teacher" id="roleTeacher" class="btn-check" />
            <label for="roleTeacher" class="role-btn">Teacher</label>

            <div class="role-slider"></div>
        </div>

        <div class="glass-card ">
            <div class="card-header-neon">
                <h2>LOG IN</h2>
            </div>

            <div class="card-body-content p-4">

                    <!-- Ô nhập Email -->
                    <div class="mb-4 text-start">
                        <label asp-for="StudentIdOrEmail" class=" form-label text-neon-dim">Student ID / Email Address</label>
                        <input asp-for="StudentIdOrEmail" type="text" class="form-control cyber-input" placeholder="daigianhi123@gmail.com">
                        <!-- Thêm dòng báo lỗi -->
                        <span asp-validation-for="StudentIdOrEmail" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Ô nhập Password -->
                    <div class="mb-3 text-start">
                        <label asp-for="Password" class="form-label text-neon-dim">Password</label>
                        <div class="position-relative">
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control cyber-input" placeholder="Enter password">
                            <!-- Thêm id="togglePassword" cho con mắt -->
                            <i class="fa-regular fa-eye position-absolute end-0 top-50 translate-middle-y me-3 text-neon-dim"
                               id="togglePassword"
                               style="cursor: pointer;"></i>
                        </div>
                        <!-- Thêm dòng báo lỗi -->
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>

                    </div>

                    <!-- Quên mật khẩu -->
                    <div class="mb-4 text-start">
                        <a href="#" class="forgot-link">Forgot Password?</a>
                    </div>

                    <!-- Nút bấm Đăng nhập -->
                    <button type="submit" class="btn btn-cyber-submit w-100 py-2.5">Log in</button>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    <script>
        const studentRadio = document.getElementById('roleStudent');
        const teacherRadio = document.getElementById('roleTeacher');
        const slider = document.querySelector('.role-slider');

        studentRadio.addEventListener('change', () => {
            if(studentRadio.checked) slider.style.left = '5px';
        });

        teacherRadio.addEventListener('change', () => {
            if(teacherRadio.checked) slider.style.left = 'calc(50% - 5px)';
        });



        const passwordInput = document.getElementById('passwordInput');
        const togglePassword = document.getElementById('togglePassword');

        togglePassword.addEventListener('click', () => {
            // 1. Kiểm tra xem mật khẩu đang ẩn hay hiện
            const isPassword = passwordInput.getAttribute('type') === 'password';

            // 2. Chuyển đổi qua lại giữa 'text' (hiện) và 'password' (ẩn)
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

            // 3. Đổi icon từ mắt mở sang mắt gạch chéo (fa-eye-slash) và ngược lại
            if (isPassword) {
                togglePassword.classList.remove('fa-eye');
                togglePassword.classList.add('fa-eye-slash');
            } else {
                togglePassword.classList.remove('fa-eye-slash');
                togglePassword.classList.add('fa-eye');
            }
        });
    </script>
}

