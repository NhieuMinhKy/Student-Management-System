@model StudentManagementSystem.Models.Student
@{
    ViewData["Title"] = "Delete Student";
    Layout ="~/Views/Shared/_Layout.cshtml";
   
}
<style>
    .confirmtext  {
        color: red; /* Màu đỏ sáng */
        font-weight: 700;
        margin-bottom: 1.5rem;
        letter-spacing: 1px;
        /* Chồng nhiều lớp shadow: các lớp đầu tạo viền sáng, các lớp sau tạo vùng tỏa sáng rộng */
        text-shadow:  0 0 10px #ff0000;
    }
</style>

<div class="container  my-5 text-light">
    <div class="row justify-content-center align-content-center">
        <div class="col-md-7">
            <h2 class="confirmtext  fw-bold">Are you sure you want to delete this student?</h2>
            
            <div class="card bg-dark text-light border-secondary shadow-sm my-5">
                <div class="card-body p-0">
                    <table class="table table-dark table-hover table-bordered mb-0">
                        <thead>
                            <tr class="table-active text-center">
                                <th>ID</th>
                                <th>Student Code</th>
                                <th>Last Name</th>
                                <th>First Name</th>
                                <th>Gender</th>
                                <th>Status</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="align-middle text-center">@Model.StudentId</td>
                                <td class="align-middle">@Model.StudentCode</td>
                                <td class="align-middle">@Model.LastName</td>
                                <td class="align-middle text-nowrap">@Model.FirstName</td>
                                <td class="align-middle">@Model.Gender</td>
                                <td class="align-baseline">@Model.Status</td>
                            </tr>
                        </tbody>

                    </table>
                </div> 
            </div>

            <form asp-action="Delete" asp-controller="Student" method="post" class="mt-3 text-end">
                <a class="btn btn-success me-2" asp-action="Index">Cancel</a>
                <input type="hidden" asp-for="StudentId"/>
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>
</div>
