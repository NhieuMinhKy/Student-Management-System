@model List<StudentManagementSystem.Models.Student> 
@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container  my-5 text-light"> 
    <div class="d-flex align-items-center justify-content-between">
        <h1 class="me-3 fw-bold text-info">  Student List</h1>
        <!--create a button to add new student-->
        <a asp-action="Create" asp-controller="Student" class="btn btn-success shadow fw-bold">  + Add Student</a>
    </div>

    <div class="card  text-light border-secondary shadow-sm my-5">
        <div class="card-body p-0">
            <table class="table table-dark table-hover table-bordered mb-0">
                <thead>
                    <tr class="table-active text-center">
                        <th>ID</th>
                        <th>Student Code</th>
                        <th>Full Name</th>
                        <th>Status</th>
                        <th>Config</th> 
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any()) //Model này là biến hệ thống của ASP.NET Core đại diện cho dữ liệu Controller lấy từ Database
                    //Model.Any() là phương thức kiểm tra xem danh sách có phần tử nào hay không
                    {
                        foreach(var student in Model)
                        {
                            <tr>
                                <td class="align-middle text-center">@student.Id</td>
                                <td class="align-middle">@student.StudentCode</td>
                                <td class="align-middle">@student.Name</td>
                                <td class="align-baseline">@student.StudentStatus</td>
                                <td class="align-middle text-center">
                                    <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-info me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <em>No data available. Click "Add Student" to get started!</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
