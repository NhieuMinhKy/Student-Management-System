@model StudentManagementSystem.Models.Teacher
@{
    ViewData["Title"] = "Create Teacher";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    input.bg-dark::placeholder {
        color: #0dcaf0 !important;
        opacity: 0.7;
    }
</style>
<div class="container  my-5 text-light">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-light border-secondary shadow-lg">
                <div class="card-header border-secondary text-center">
                    <h4 class="mb-0 text-success fw-bold"> Fill in Teacher Information</h4>
                </div>

                <div class="card-body p-4">
                    <!-- Form -->
                    <form asp-action="Create" method="post">

                        <!-- Hiển thị tóm tắt lỗi chung nếu có -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- TeacherCode-->
                        <div class="mb-3">
                            <label asp-for="TeacherCode" class="form-label fw-bold">Teacher Code</label>
                            <input asp-for="TeacherCode" class="form-control bg-dark text-light border-secondary" placeholder="TC0001..." />
                            <span asp-validation-for="TeacherCode" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!--TeacherName-->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold">Full Name</label>
                            <input asp-for="Name" class="form-control bg-dark text-light border-secondary" placeholder="Enter Teacher Name" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- StudentStatus -->
                        <div class="mb-4">
                            <label asp-for="TeacherStatus" class="form-label fw-bold">Status</label>
                            <select asp-for="TeacherStatus" class="form-control bg-dark text-light border-secondary">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="TeacherStatus" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Buttons-->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-primary">Cancel & Back</a>
                            <button type="submit" class="btn btn-success px-4">SAVE</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Đoạn Script này giúp kích hoạt tính năng báo chữ đỏ BẮT BUỘC NHẬP ngay trên trình duyệt mà không cần tải lại trang -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}