@model List<StudentManagementSystem.Models.Teacher>
@{
    ViewData["Title"] = "Teacher List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container  my-5 text-light">
    <div class="d-flex align-items-center justify-content-between">
        <h1 class="me-3 fw-bold text-info">  Teacher List</h1>
        <!--create a button to add new student-->
        <a asp-action="CreateOrEdit" asp-controller="Teacher" class="btn btn-success shadow fw-bold">  + Add Teacher</a>
    </div>

    <div class="card  text-light border-secondary shadow-sm my-5">
        <div class="card-body p-0">
            <table class="table table-dark table-hover table-bordered mb-0">
                <thead>
                    <tr class="table-active text-center">
                        <th>ID</th>
                        <th>Teacher Code</th>
                        <th>Full Name</th>
                        <th>DepartmentId</th>
                        <th>Status</th>
                        <th>Config</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any()) 
                    {
                        foreach (var teacher in Model)
                        {
                            <tr>
                                <td class="align-middle text-center">@teacher.TeacherId</td>
                                <td class="align-middle">@teacher.TeacherCode</td>
                                <td class="align-middle">@teacher.FullName</td>
                                <td class="align-middle">@teacher.DepartmentId</td>
                                <td class="align-baseline">@teacher.Status</td>
                                <td class="align-middle text-center">
                                    <a asp-action="CreateOrEdit" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-outline-info me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <em>No data available. Click "Add Teacher" to get started!</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
